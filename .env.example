# Vite loads .env.local over .env. Values here are placeholders only.
VITE_BACKEND_URL=http://localhost:5000
VITE_FRONTEND_URL=http://localhost:5174
VITE_GOOGLE_CLIENT_ID=
VITE_IS_AUTHENTICATED=

# ── Funnel V2 ──
VITE_FUNNEL_V2=false
VITE_LIBRARY=false
VITE_TRIAL_BILLING=false
VITE_LANDING_V3=false
# Editor private beta: true shows AI edits on the pricing and landing pages. In the app the backend decides (EDITOR_ENABLED).
VITE_EDITOR_PUBLIC=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://t.vireact.io
# Optional, e.g. vireact/strategy-call — leave empty to hide the call card.
VITE_CALCOM_LINK=
VITE_SITE_URL=http://localhost:5174
# Post scheduling private beta: true shows the posting calendar and "Schedule post" buttons. Also needs the backend switch (GET /posts/capabilities enabled). Off by default.
VITE_PUBLISHING=false
